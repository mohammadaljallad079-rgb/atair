# Optional. Leave UNSET to call the API on the app's own origin (recommended when
# the API is behind the same reverse proxy — the app forwards /api/* to the API).
# Set only for a split-origin deployment (no trailing slash, no /api suffix).
#NEXT_PUBLIC_API_URL=http://localhost:3000

# Where the Next server forwards /api/* (same-origin mode). Defaults to localhost:3000.
#API_PROXY_TARGET=http://localhost:3000
