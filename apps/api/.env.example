NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://atair:atair_dev_pw@localhost:5432/atair?schema=public"

# Generate strong random values in production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
BCRYPT_ROUNDS=12

# Comma-separated list of allowed browser origins (admin + merchant portals).
CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003
